# 0G Galileo testnet
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Optional funded development signers. Never commit real keys.
OG_COMPUTE_PRIVATE_KEY=
OG_STORAGE_PRIVATE_KEY=

# Optional dedicated signer for expiring settleWithReceipt authorizations.
# Deploy ThemisEscrow with this key's PUBLIC address as the verifier.
THEMIS_VERIFIER_PRIVATE_KEY=
THEMIS_DEPLOYER_PRIVATE_KEY=

# Require every issued receipt to finish an encrypted 0G Storage upload.
THEMIS_EVIDENCE_ENCRYPTION_KEY=
THEMIS_REQUIRE_STORAGE=false
THEMIS_CHALLENGE_SECRET=
THEMIS_API_KEY=
THEMIS_ESCROW_ADDRESS=0x46032577415dfaeddc9758a9d72bc16c47cb1c47
NEXT_PUBLIC_ESCROW_ADDRESS=0x46032577415dfaeddc9758a9d72bc16c47cb1c47

# Set after deployment for absolute social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
