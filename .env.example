THEMIS_DEPLOYER_PRIVATE_KEY=
THEMIS_RESOLVER_ADDRESS=
THEMIS_DEMO_BUYER_PRIVATE_KEY=
THEMIS_DEMO_WORKER_PRIVATE_KEY=
THEMIS_DEMO_AGENTIC_ID=

# Require every issued receipt to finish an encrypted 0G Storage upload.
THEMIS_EVIDENCE_ENCRYPTION_KEY=
THEMIS_REQUIRE_STORAGE=false
THEMIS_CHALLENGE_SECRET=
THEMIS_API_KEY=
THEMIS_ESCROW_ADDRESS=0x0B1Cdef5CE5EE077BFEC7d8B50C3fE3073857640
NEXT_PUBLIC_ESCROW_ADDRESS=0x0B1Cdef5CE5EE077BFEC7d8B50C3fE3073857640
THEMIS_ESCROW_VERSION=2
THEMIS_DEMO_USDC_ADDRESS=0x31938FdAF51bf56408471901A1c16491718E40f0
NEXT_PUBLIC_DEMO_USDC_ADDRESS=0x31938FdAF51bf56408471901A1c16491718E40f0

